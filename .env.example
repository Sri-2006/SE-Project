# Copy to .env for Docker Compose. Replace all placeholder secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-another-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For HTTPS production: DJANGO_DEBUG=0 and configure your real hostname and trusted origin.
CSRF_TRUSTED_ORIGINS=

